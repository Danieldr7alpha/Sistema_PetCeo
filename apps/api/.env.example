# Desenvolvimento local:
DATABASE_URL="postgresql://USUARIO:SENHA@HOST:5432/BANCO?schema=public"
# Para Supabase no computador local, use a string "Session pooler" exibida em Connect.
# Codifique caracteres especiais da senha na URL e nunca salve credenciais reais neste exemplo.
JWT_SECRET="change-me"
PORT=3333
WEB_ORIGIN="http://localhost:5173"

# Supabase PostgreSQL:
# Substitua DATABASE_URL pela Connection string do Supabase em modo pooled/session quando for usar o banco remoto.
# Nunca coloque SUPABASE_SERVICE_ROLE_KEY no frontend.
